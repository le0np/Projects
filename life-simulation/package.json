{
  "name": "life-simulation",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx packages/content/src/cli.ts",
    "check": "npm run typecheck && npm run validate && npm test",
    "sim": "tsx packages/sim/src/cli.ts",
    "sim:batch": "tsx packages/sim/src/batch-cli.ts",
    "server": "tsx --env-file-if-exists=.env packages/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
