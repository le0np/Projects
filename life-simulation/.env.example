# Copy to .env (never commit .env). All variables are optional.

# HTTP/WebSocket port
PORT=3000

# PostgreSQL connection string. If empty, an embedded PGlite (PostgreSQL in WebAssembly) is used.
DATABASE_URL=
# PGlite data directory (only without DATABASE_URL). Set to empty for an in-memory database.
PGLITE_DIR=./data/pglite

# Characters per session (humans + bots), max humans per session,
# and how long the first player waits before bots fill the empty seats.
SESSION_SIZE=6
MAX_HUMANS=4
FILL_AFTER_SECONDS=10

# Session length in session-seconds, and a speed-up factor (1 = real time).
SESSION_DURATION_SECONDS=480
TIME_SCALE=1

# Directory of the built web client (default: packages/web/dist if it exists).
WEB_DIST=
