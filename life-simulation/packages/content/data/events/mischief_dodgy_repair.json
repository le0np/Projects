{
  "schemaVersion": 1,
  "id": "mischief_dodgy_repair",
  "version": 1,
  "title": "A Slow Leak",
  "category": "everyday",
  "trigger": "followup_only",
  "hidden": true,
  "importance": "simple",
  "cooldown": {
    "maxPerSession": 8
  },
  "location": {
    "at": [
      "home"
    ],
    "of": "role:victim"
  },
  "roles": {
    "victim": {
      "count": 1
    },
    "culprit": {
      "count": 1,
      "aware": false
    }
  },
  "text": {
    "public": "Two days after a \"quick repair\", {victim}'s car dies on the ring road.",
    "private": {
      "victim": "The garage swore it was fixed. Now there is oil everywhere."
    }
  },
  "choices": {
    "victim": [
      {
        "id": "tow",
        "label": "Call a tow truck",
        "tags": [
          "ignore"
        ],
        "default": true,
        "perceived": {
          "money": -1
        }
      },
      {
        "id": "second_opinion",
        "label": "Get a second opinion at another garage",
        "tags": [
          "truth"
        ],
        "perceived": {
          "money": -1,
          "risk": 1
        }
      },
      {
        "id": "confront",
        "label": "Confront {culprit} in front of everyone",
        "tags": [
          "threaten",
          "truth"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "reputation": 1,
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "report",
        "label": "Report {culprit}",
        "tags": [
          "truth",
          "take_responsibility"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "revenge",
        "label": "Smile, and start planning your revenge on {culprit}",
        "tags": [
          "risk"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "risk": 1,
          "relation": {
            "culprit": -1
          }
        },
        "effects": [
          {
            "type": "fact",
            "target": "self",
            "key": "revenge_on",
            "about": "role:culprit"
          }
        ]
      }
    ]
  },
  "outcomes": [
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -30,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 3
          }
        }
      ],
      "text": {
        "victim": "You tell {culprit} exactly what you saw. Half the street hears it.",
        "culprit": "{victim} confronts you in front of everyone. They know it was you."
      }
    },
    {
      "id": "reported",
      "when": {
        "chose": "report",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -10,
            "career": -5
          }
        }
      ],
      "text": {
        "victim": "You report {culprit}. It goes on their record.",
        "culprit": "An official letter: {victim} reported you. Your boss has questions."
      }
    },
    {
      "id": "revenge_planned",
      "when": {
        "chose": "revenge",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -20,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You say nothing. {culprit} has no idea what is coming. (You have a free scheme against them.)",
        "culprit": "{victim} smiles at you a little too long."
      }
    },
    {
      "id": "second_opinion",
      "when": {
        "chose": "second_opinion",
        "role": "victim"
      },
      "chance": 0.4,
      "important": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "money": -4
          }
        },
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        }
      ],
      "text": {
        "victim": "\"Somebody loosened this on purpose,\" says the other mechanic. Somebody called {culprit}.",
        "culprit": "{victim} took the car to another garage. Uh-oh."
      }
    },
    {
      "id": "towed",
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "money": -9,
            "mental": -3
          }
        },
        {
          "type": "mark",
          "target": "role:victim",
          "mark": "flat_tyres",
          "seconds": 60
        }
      ],
      "text": {
        "victim": "A tow truck, a new part and a very long afternoon.",
        "culprit": "{victim}'s car is back at the garage. Good for business."
      }
    }
  ]
}
