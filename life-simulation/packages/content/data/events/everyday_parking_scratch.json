    {
      "id": "got_away",
      "effects": [
        {
          "type": "attr",
          "target": "role:driver",
          "delta": {
            "mental": -2
          }
        },
        {
          "type": "attr",
          "target": "role:owner",
          "delta": {
            "money": -10,
            "mental": -3
          }
        }
      ],
      "text": {
        "driver": "Nobody ever finds out. You still think about it when you park.",
        "owner": "Nobody knows who did it. The repair is on you."
