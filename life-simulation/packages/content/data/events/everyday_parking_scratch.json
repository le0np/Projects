      "when": {
        "chose": "police",
        "role": "owner"
      },
      "chance": 0.35,
      "important": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:driver",
          "delta": {
            "money": -15,
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:owner",
          "delta": {
            "mental": 1
          }
        }
      ],
      "text": {
