{
  "schemaVersion": 1,
  "id": "mischief_fake_news",
  "version": 1,
  "title": "Fake News",
  "category": "everyday",
  "trigger": "followup_only",
  "hidden": true,
  "importance": "simple",
  "cooldown": {
    "maxPerSession": 8
  },
  "location": {
    "at": [
      "home"
    ],
    "of": "role:victim"
  },
  "roles": {
    "victim": {
      "count": 1
    },
    "culprit": {
      "count": 1,
      "aware": false
    }
  },
  "text": {
    "public": "A local news site runs a story about {victim}. It is not flattering.",
    "private": {
      "victim": "\"Local resident caught stealing from charity box.\" You have never even seen the charity box."
    }
  },
  "choices": {
    "victim": [
      {
        "id": "correction",
        "label": "Demand a correction",
        "tags": [
          "truth"
        ],
        "perceived": {
          "reputation": 1,
          "mental": -1
        }
      },
      {
        "id": "ignore",
        "label": "Ignore it, it will blow over",
        "tags": [
          "ignore"
        ],
        "default": true,
        "perceived": {
          "reputation": -1
        }
      },
      {
        "id": "confront",
        "label": "Confront {culprit} in front of everyone",
        "tags": [
          "threaten",
          "truth"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "reputation": 1,
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "report",
        "label": "Report {culprit}",
        "tags": [
          "truth",
          "take_responsibility"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "revenge",
        "label": "Smile, and start planning your revenge on {culprit}",
        "tags": [
          "risk"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "risk": 1,
          "relation": {
            "culprit": -1
          }
        },
        "effects": [
          {
            "type": "fact",
            "target": "self",
            "key": "revenge_on",
            "about": "role:culprit"
          }
        ]
      }
    ]
  },
  "outcomes": [
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -30,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 3
          }
        }
      ],
      "text": {
        "victim": "You tell {culprit} exactly what you saw. Half the street hears it.",
        "culprit": "{victim} confronts you in front of everyone. They know it was you."
      }
    },
    {
      "id": "reported",
      "when": {
        "chose": "report",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -10,
            "career": -5
          }
        }
      ],
      "text": {
        "victim": "You report {culprit}. It goes on their record.",
        "culprit": "An official letter: {victim} reported you. Your boss has questions."
      }
    },
    {
      "id": "revenge_planned",
      "when": {
        "chose": "revenge",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -20,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You say nothing. {culprit} has no idea what is coming. (You have a free scheme against them.)",
        "culprit": "{victim} smiles at you a little too long."
      }
    },
    {
      "id": "corrected",
      "when": {
        "chose": "correction",
        "role": "victim"
      },
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "reputation": -3,
            "mental": -3
          }
        }
      ],
      "text": {
        "victim": "A tiny correction appears on page nine. Some people still look at you funny.",
        "culprit": "They printed a correction. Nobody reads corrections."
      }
    },
    {
      "id": "smeared",
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "reputation": -9,
            "mental": -4
          }
        }
      ],
      "text": {
        "victim": "For a week, people hold on to their wallets when you walk past.",
        "culprit": "The story about {victim} is everywhere. Journalism!"
      }
    }
  ]
}
