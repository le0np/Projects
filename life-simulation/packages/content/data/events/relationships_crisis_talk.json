          "about": "role:b",
          "remove": true
        },
        {
          "type": "attr",
          "target": "role:a",
          "delta": {
            "mental": -8
          }
        },
        {
          "type": "attr",
          "target": "role:b",
          "delta": {
            "mental": -12
          }
        },
        {
          "type": "move",
          "target": "role:a",
          "to": "bar",
          "staySeconds": 8
        }
      ],
      "text": {
        "a": "It is over. It hurts, but it also feels like air.",
        "b": "{a} ends it. You did not think it would really happen."
      }
    },
    {
      "id": "recommitted",
      "when": {
        "all": [
          {
            "any": [
              {
                "chose": "work_on_it",
                "role": "a"
              },
              {
                "chose": "therapy",
                "role": "a"
              }
            ]
          },
          {
            "chose": "open_up",
            "role": "b"
          }
        ]
      },
      "revealChoices": true,
      "effects": [
        {
          "type": "relation",
          "from": "role:a",
          "to": "role:b",
          "affinity": 25,
          "trust": 25,
          "mutual": true
        },
        {
          "type": "fact",
          "target": "role:a",
          "key": "suspects_partner",
          "about": "role:b",
          "remove": true
        },
        {
          "type": "attr",
          "target": "role:a",
          "delta": {
            "mental": 6
          }
        },
        {
          "type": "attr",
          "target": "role:b",
          "delta": {
            "mental": 6
          }
        }
      ],
      "text": {
        "a": "A long, honest night. You feel closer than you have in months.",
        "b": "A long, honest night. You feel closer than you have in months."
      }
    },
    {
      "id": "fight",
      "when": {
        "chose": "defensive",
        "role": "b"
      },
      "effects": [
        {
          "type": "relation",
          "from": "role:a",
          "to": "role:b",
          "affinity": -15,
          "trust": -10,
          "mutual": true
        },
        {
          "type": "attr",
          "target": "role:a",
          "delta": {
            "mental": -6
          }
        },
        {
          "type": "attr",
          "target": "role:b",
          "delta": {
            "mental": -6
          }
        }
      ],
      "text": {
        "a": "It turns into a fight. Doors are slammed.",
        "b": "It turns into a fight. Doors are slammed."
      }
    },
    {
      "id": "unresolved",
      "effects": [
        {
          "type": "attr",
          "target": "role:a",
          "delta": {
            "mental": -4
          }
        }
      ],
      "text": {
        "a": "Nothing really gets said.",
        "b": "The talk fizzles out. The tension does not."
      }
    }
  ]
