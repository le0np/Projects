        }
      },
      {
        "relation": {
          "from": "role:a",
          "to": "role:b",
          "trustLte": 30
        }
      }
    ]
  },
  "text": {
    "public": "{a} sits {b} down: \"We need to talk.\"",
    "private": {
      "a": "Something has been wrong between you for a while.",
      "b": "You can feel this conversation has been coming."
    }
  },
  "choices": {
    "a": [
      {
        "id": "work_on_it",
        "label": "Say you want to make it work",
        "tags": [
          "help",
          "truth"
        ],
        "perceived": {
          "relation": {
            "b": 1
          }
        }
      },
      {
        "id": "break_up",
        "label": "End it",
        "tags": [
          "refuse"
        ],
        "perceived": {
          "mental": -1,
          "relation": {
            "b": -2
          }
        }
      },
      {
        "id": "therapy",
        "label": "Suggest couples counselling",
        "tags": [
          "negotiate",
          "help"
        ],
        "perceived": {
          "money": -1,
          "relation": {
            "b": 1
          }
        }
      },
      {
        "id": "avoid",
        "label": "Lose your nerve and talk about dinner",
        "tags": [
          "ignore"
        ],
        "default": true
      }
    ],
    "b": [
      {
        "id": "open_up",
        "label": "Be completely honest about how you feel",
        "tags": [
          "truth"
        ],
        "perceived": {
          "relation": {
            "a": 1
          }
        }
      },
      {
        "id": "defensive",
        "label": "Get defensive",
        "tags": [
          "threaten"
        ],
        "perceived": {
          "relation": {
            "a": -1
          }
        }
      },
      {
        "id": "agree",
        "label": "Agree with whatever {a} says",
        "tags": [
          "ignore"
        ],
        "default": true
      }
    ]
  },
  "outcomes": [
    {
      "id": "break_up",
      "when": {
        "chose": "break_up",
        "role": "a"
