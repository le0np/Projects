{
  "schemaVersion": 1,
  "id": "relationships_crisis_talk",
  "version": 2,
  "title": "We Need to Talk",
  "category": "relationships",
  "trigger": "director",
  "importance": "important",
  "weight": 6,
  "cooldown": {
    "maxPerSession": 2,
    "minGapSeconds": 60
  },
  "location": {
    "at": [
      "home"
    ]
  },
  "roles": {
    "a": {
      "count": 1
    },
    "b": {
      "count": 1,
      "conditions": {
        "relation": {
          "to": "role:a",
          "typeIn": [
            "partner"
          ]
        }
      }
    }
  },
  "conditions": {
