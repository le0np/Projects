      "revealChoices": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:trapped",
          "delta": {
            "health": -5,
            "mental": 8
          }
        }
      ],
      "text": {
        "trapped": "Hands grab you in the smoke and pull you out. You are coughing, but alive.",
        "neighbours": "{trapped} is pulled out alive. You will all tell this story for years."
      }
    },
    {
      "id": "jumped",
