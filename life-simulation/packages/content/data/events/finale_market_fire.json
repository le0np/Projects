          "type": "attr",
          "target": "role:trapped",
          "delta": {
            "health": -15,
            "mental": -5
          }
        }
      ],
      "text": {
        "trapped": "Nobody came. You jump onto the market awnings and roll into the street, bruised.",
        "neighbours": "Nobody went in. {trapped} jumps from the window and lands on the awnings."
      }
    },
    {
      "id": "brigade",
      "important": true,
      "revealChoices": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:trapped",
          "delta": {
            "health": -25,
            "mental": -15
          }
        },
        {
          "type": "relation",
          "from": "role:trapped",
          "to": "role:neighbours",
          "affinity": -10,
          "trust": -10
        }
      ],
      "text": {
        "trapped": "Ten long minutes later the fire brigade gets you out. You saw everyone just standing there.",
        "neighbours": "The fire brigade gets {trapped} out, badly hurt. Nobody looks anybody in the eye."
      }
    }
