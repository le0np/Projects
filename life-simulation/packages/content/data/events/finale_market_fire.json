  "outcomes": [
    {
      "id": "carried_out",
      "when": {
        "chose": "owe_them",
        "role": "neighbours"
      },
      "important": true,
      "revealChoices": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:trapped",
          "delta": {
            "health": -5,
            "mental": 10
          }
        }
      ],
      "text": {
        "trapped": "Someone you once helped comes through the smoke for you. Old debts, paid in full.",
        "neighbours": "Someone who owed {trapped} a favour carries them out. The street cheers."
      }
    },
    {
      "id": "rescued",
      "when": {
        "any": [
          {
            "chose": "friend_in",
            "role": "neighbours"
          },
          {
            "chose": "rescue",
            "role": "neighbours"
          },
          {
            "chose": "ladder",
            "role": "neighbours"
          }
        ]
