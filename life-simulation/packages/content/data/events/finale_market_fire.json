{
  "schemaVersion": 1,
  "id": "finale_market_fire",
  "version": 1,
  "title": "Fire on Market Street",
  "category": "critical",
  "trigger": "finale",
  "importance": "important",
  "weight": 10,
  "location": {
    "at": [
      "shop"
    ]
  },
  "roles": {
