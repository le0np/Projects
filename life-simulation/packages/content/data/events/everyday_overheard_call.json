{
  "schemaVersion": 1,
  "id": "everyday_overheard_call",
  "version": 1,
  "title": "Thin Walls",
  "category": "everyday",
  "trigger": "director",
  "hidden": true,
  "importance": "multi",
  "weight": 6,
  "cooldown": {
    "maxPerSession": 2,
    "maxPerCharacter": 1
