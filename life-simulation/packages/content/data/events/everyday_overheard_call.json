      "count": 1,
      "conditions": {
        "relation": {
          "to": "role:caller",
          "typeIn": [
            "colleague",
            "acquaintance",
            "friend",
            "rival"
          ]
        }
      }
    }
  },
  "text": {
    "public": "{caller} takes a phone call in the next room.",
    "private": {
      "listener": "Through the thin wall you hear {caller} admit to taking money from the office fund."
    }
  },
  "choices": {
    "listener": [
      {
        "id": "confront",
        "label": "Talk to {caller} privately",
        "tags": [
          "truth",
          "negotiate"
        ],
        "perceived": {
          "relation": {
            "caller": 0
          }
        }
      },
      {
        "id": "report",
        "label": "Report it to management",
        "tags": [
          "truth"
        ],
        "perceived": {
          "reputation": 1,
          "relation": {
            "caller": -2
          }
        }
      },
      {
        "id": "blackmail",
        "label": "Hint that you know — and that silence has a price",
        "tags": [
          "threaten",
          "lie"
        ],
        "perceived": {
          "money": 2,
          "risk": 1,
          "relation": {
            "caller": -2
          }
        }
      },
      {
        "id": "investigate",
        "label": "Quietly dig deeper before deciding anything",
        "tags": [
          "risk"
        ],
        "careers": [
          "journalist"
        ],
        "perceived": {
          "career": 1
        }
      },
      {
        "id": "keep_quiet",
        "label": "Keep it to yourself — for now",
        "tags": [
          "ignore"
        ],
        "default": true
      }
    ]
