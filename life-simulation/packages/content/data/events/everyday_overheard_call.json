      ],
      "text": {
        "caller": "{listener} knows. Paying them is cheaper than losing your job — for now.",
        "listener": "{caller} pays. You know you have made an enemy."
      }
    },
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "listener"
      },
      "effects": [
        {
          "type": "attr",
          "target": "role:caller",
          "delta": {
            "mental": -5
          }
        },
        {
          "type": "fact",
          "target": "role:listener",
          "key": "knows_secret",
          "about": "role:caller"
        },
        {
          "type": "relation",
          "from": "role:caller",
          "to": "role:listener",
          "trust": 10
        }
      ],
      "text": {
        "caller": "{listener} heard everything, but gives you a chance to put the money back.",
        "listener": "{caller} goes pale, then promises to return the money."
      }
    },
    {
      "id": "investigated",
      "when": {
        "chose": "investigate",
        "role": "listener"
      },
      "effects": [
        {
          "type": "fact",
          "target": "role:listener",
          "key": "knows_secret",
          "about": "role:caller"
