        {
          "type": "attr",
          "target": "role:listener",
          "delta": {
            "career": 3
          }
        }
      ],
      "text": {
        "caller": "Just an ordinary day.",
        "listener": "A few records later you have the whole story. It could be a scoop — or leverage."
      }
    },
    {
      "id": "kept_quiet",
      "effects": [
        {
          "type": "fact",
          "target": "role:listener",
          "key": "knows_secret",
          "about": "role:caller"
        }
      ],
      "text": {
        "caller": "Just an ordinary day.",
        "listener": "You say nothing. But you will not forget it."
      }
    }
  ]
}
