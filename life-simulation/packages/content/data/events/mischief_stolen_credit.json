{
  "schemaVersion": 1,
  "version": 3,
  "id": "mischief_stolen_credit",
  "title": "Who Had That Idea?",
  "category": "career",
  "trigger": "followup_only",
  "hidden": true,
  "importance": "multi",
  "cooldown": {
    "maxPerSession": 8
  },
  "location": {
    "at": [
      "work"
    ],
    "of": "role:victim"
  },
  "roles": {
    "victim": {
      "count": 1
    },
    "culprit": {
      "count": 1,
      "aware": false
    }
  },
  "text": {
    "public": "Everyone is praising a brilliant new idea at {victim}'s workplace.",
    "private": {
      "victim": "It is your idea. Word for word. Somebody presented it first."
    }
  },
  "choices": {
    "victim": [
      {
        "id": "investigate",
        "label": "Find out who presented it",
        "tags": [
          "truth",
          "risk"
        ],
        "perceived": {
          "risk": 1
        }
      },
      {
        "id": "prove",
        "label": "Show your dated notes to the boss",
        "tags": [
          "truth"
        ],
        "perceived": {
          "career": 1
        }
      },
      {
        "id": "swallow",
        "label": "Let it go — you have more ideas",
        "tags": [
          "ignore"
        ],
        "default": true,
        "perceived": {
          "career": -1
        }
      },
      {
        "id": "confront",
        "label": "Confront {culprit} in public",
        "tags": [
          "threaten",
          "truth"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "reputation": 1,
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "report",
        "label": "Report {culprit}",
        "tags": [
          "truth",
          "take_responsibility"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "revenge",
        "label": "Smile and plan your revenge on {culprit}",
        "tags": [
          "risk"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "risk": 1,
          "relation": {
            "culprit": -1
          }
        },
        "effects": [
          {
            "type": "fact",
            "target": "self",
            "key": "revenge_on",
            "about": "role:culprit"
          }
        ]
      }
    ]
  },
  "outcomes": [
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -30,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 3
          }
        }
      ],
      "text": {
        "victim": "You tell {culprit} exactly what you saw. Half the street hears it.",
        "culprit": "{victim} confronts you in front of everyone. They know it was you."
      }
    },
    {
      "id": "reported",
      "when": {
        "chose": "report",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -10,
            "career": -5
          }
        }
      ],
      "text": {
        "victim": "You report {culprit}. It goes on their record.",
        "culprit": "An official letter: {victim} reported you. Your boss has questions."
      }
    },
    {
      "id": "revenge_planned",
      "when": {
        "chose": "revenge",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -20,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You say nothing. {culprit} has no idea what is coming. (You have a free scheme against them.)",
        "culprit": "{victim} smiles at you a little too long."
      }
    },
    {
      "id": "proved",
      "when": {
        "chose": "prove",
        "role": "victim"
      },
      "chance": 0.6,
      "important": true,
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "career": 6
          }
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -8
          }
        },
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "setType": "rival",
          "affinity": -25
        }
      ],
      "text": {
        "victim": "Your notes are dated three weeks earlier. {culprit} has some explaining to do.",
        "culprit": "{victim} had dated notes. Who keeps dated notes?!"
      }
    },
    {
      "id": "found_out",
      "when": {
        "chose": "investigate",
        "role": "victim"
      },
      "chance": 0.45,
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "setType": "enemy",
          "affinity": -35,
          "trust": -30
        }
      ],
      "text": {
        "victim": "You follow the trail. It was {culprit}! You will remember this.",
        "culprit": "You have a strange feeling that {victim} knows."
      }
    },
    {
      "id": "robbed",
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "career": -4,
            "mental": -4
          }
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "career": 5
          }
        }
      ],
      "text": {
        "victim": "Someone else gets the credit. You start writing ideas in invisible ink.",
        "culprit": "Your \"brilliant idea\" gets you a pat on the back."
      }
    }
  ]
}
