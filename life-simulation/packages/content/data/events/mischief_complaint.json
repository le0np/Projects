{
  "schemaVersion": 1,
  "version": 3,
  "id": "mischief_complaint",
  "title": "A Letter to the Boss",
  "category": "career",
  "trigger": "followup_only",
  "hidden": true,
  "importance": "multi",
  "cooldown": {
    "maxPerSession": 8
  },
  "location": {
    "at": [
      "work"
    ],
    "of": "role:victim"
  },
  "roles": {
    "victim": {
      "count": 1
    },
    "culprit": {
      "count": 1,
      "aware": false
    }
  },
  "text": {
    "public": "{victim}'s boss waves an anonymous letter around the office.",
    "private": {
      "victim": "The letter claims you microwave fish every day. You microwaved fish once."
    }
  },
  "choices": {
    "victim": [
      {
        "id": "investigate",
        "label": "Compare the handwriting",
        "tags": [
          "truth",
          "risk"
        ],
        "perceived": {
          "risk": 1
        }
      },
      {
        "id": "apologise",
        "label": "Apologise for the fish",
        "tags": [
          "apologize"
        ],
        "default": true,
        "perceived": {
          "career": -1
        }
      },
      {
        "id": "rights",
        "label": "Demand the letter, cite the harassment policy",
        "tags": [
          "negotiate",
          "truth"
        ],
        "careers": [
          "lawyer"
        ],
        "perceived": {
          "career": 1
        }
      },
      {
        "id": "confront",
        "label": "Confront {culprit} in public",
        "tags": [
          "threaten",
          "truth"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "reputation": 1,
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "report",
        "label": "Report {culprit}",
        "tags": [
          "truth",
          "take_responsibility"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "revenge",
        "label": "Smile and plan your revenge on {culprit}",
        "tags": [
          "risk"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "risk": 1,
          "relation": {
            "culprit": -1
          }
        },
        "effects": [
          {
            "type": "fact",
            "target": "self",
            "key": "revenge_on",
            "about": "role:culprit"
          }
        ]
      }
    ]
  },
  "outcomes": [
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -30,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 3
          }
        }
      ],
      "text": {
        "victim": "You tell {culprit} exactly what you saw. Half the street hears it.",
        "culprit": "{victim} confronts you in front of everyone. They know it was you."
      }
    },
    {
      "id": "reported",
      "when": {
        "chose": "report",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -10,
            "career": -5
          }
        }
      ],
      "text": {
        "victim": "You report {culprit}. It goes on their record.",
        "culprit": "An official letter: {victim} reported you. Your boss has questions."
      }
    },
    {
      "id": "revenge_planned",
      "when": {
        "chose": "revenge",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -20,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You say nothing. {culprit} has no idea what is coming. (You have a free scheme against them.)",
        "culprit": "{victim} smiles at you a little too long."
      }
    },
    {
      "id": "found_out",
      "when": {
        "chose": "investigate",
        "role": "victim"
      },
      "chance": 0.45,
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "setType": "enemy",
          "affinity": -35,
          "trust": -30
        }
      ],
      "text": {
        "victim": "You follow the trail. It was {culprit}! You will remember this.",
        "culprit": "You have a strange feeling that {victim} knows."
      }
    },
    {
      "id": "policy",
      "when": {
        "chose": "rights",
        "role": "victim"
      },
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "career": 3,
            "reputation": 2
          }
        }
      ],
      "text": {
        "victim": "HR shreds the letter and sends everyone a memo about kindness.",
        "culprit": "Your letter to {victim}'s boss backfired into a kindness memo."
      }
    },
    {
      "id": "fish_shame",
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "career": -5,
            "mental": -4
          }
        }
      ],
      "text": {
        "victim": "Your boss now sniffs the air whenever you walk past.",
        "culprit": "{victim} got told off. Mission accomplished."
      }
    }
  ]
}
