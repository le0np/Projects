{
  "schemaVersion": 1,
  "id": "mischief_fake_lawsuit",
  "version": 3,
  "title": "A Letter from a Lawyer",
  "category": "everyday",
  "trigger": "followup_only",
  "hidden": true,
  "importance": "simple",
  "cooldown": {
    "maxPerSession": 8
  },
  "location": {
    "at": [
      "home"
    ],
    "of": "role:victim"
  },
  "roles": {
    "victim": {
      "count": 1
    },
    "culprit": {
      "count": 1,
      "aware": false
    }
  },
  "text": {
    "public": "{victim} gets a thick envelope from a law firm.",
    "private": {
      "victim": "They demand 5,000 for \"emotional damages\" caused by your hedge. It looks very official."
    }
  },
  "choices": {
    "victim": [
      {
        "id": "pay",
        "label": "Pay something to make it go away",
        "tags": [
          "sacrifice"
        ],
        "perceived": {
          "money": -2,
          "mental": 1
        }
      },
      {
        "id": "ignore",
        "label": "Put it in a drawer and worry",
        "tags": [
          "ignore"
        ],
        "default": true,
        "perceived": {
          "mental": -1
        }
      },
      {
        "id": "confront",
        "label": "Confront {culprit}",
        "tags": [
          "threaten",
          "truth"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "reputation": 1,
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "report",
        "label": "Report {culprit}",
        "tags": [
          "truth",
          "take_responsibility"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "relation": {
            "culprit": -2
          }
        }
      },
      {
        "id": "revenge",
        "label": "Plan revenge on {culprit}",
        "tags": [
          "risk"
        ],
        "condition": {
          "fact": "spotted",
          "about": "role:culprit"
        },
        "perceived": {
          "risk": 1,
          "relation": {
            "culprit": -1
          }
        },
        "effects": [
          {
            "type": "fact",
            "target": "self",
            "key": "revenge_on",
            "about": "role:culprit"
          }
        ]
      }
    ]
  },
  "outcomes": [
    {
      "id": "confronted",
      "when": {
        "chose": "confront",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -30,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -6
          }
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 3
          }
        }
      ],
      "text": {
        "victim": "You tell {culprit} exactly what you saw. Half the street hears it.",
        "culprit": "{victim} confronts you in front of everyone. They know it was you."
      }
    },
    {
      "id": "reported",
      "when": {
        "chose": "report",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -25,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:culprit",
          "delta": {
            "reputation": -10,
            "career": -5
          }
        }
      ],
      "text": {
        "victim": "You report {culprit}. It goes on their record.",
        "culprit": "An official letter: {victim} reported you. Your boss has questions."
      }
    },
    {
      "id": "revenge_planned",
      "when": {
        "chose": "revenge",
        "role": "victim"
      },
      "important": true,
      "effects": [
        {
          "type": "fact",
          "target": "role:victim",
          "key": "knows_secret",
          "about": "role:culprit"
        },
        {
          "type": "relation",
          "from": "role:victim",
          "to": "role:culprit",
          "affinity": -20,
          "trust": -30
        },
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You say nothing. {culprit} has no idea what is coming. (You have a free scheme against them.)",
        "culprit": "{victim} smiles at you a little too long."
      }
    },
    {
      "id": "paid",
      "when": {
        "chose": "pay",
        "role": "victim"
      },
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "money": -10,
            "mental": 2
          }
        }
      ],
      "text": {
        "victim": "You pay. The \"law firm\" cashes the cheque suspiciously fast.",
        "culprit": "{victim} paid. You will have to give that back. Probably."
      }
    },
    {
      "id": "worried",
      "effects": [
        {
          "type": "attr",
          "target": "role:victim",
          "delta": {
            "mental": -8
          }
        }
      ],
      "text": {
        "victim": "You lose two weeks of sleep before you notice the firm does not exist.",
        "culprit": "{victim} looks very tired lately."
      }
    }
  ]
}
