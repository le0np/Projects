            "affinity": 15
          }
        ]
      },
      {
        "id": "ghost",
        "label": "Tell a ghost story",
        "tags": [
          "risk"
        ],
        "perceived": {
          "mental": 1
        }
      },
      {
        "id": "hoard",
        "label": "Keep your candles a secret",
        "tags": [
          "lie"
        ],
        "default": true
