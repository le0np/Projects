{
  "schemaVersion": 1, "id": "relationships_secret_message", "version": 1, "title": "A Message on the Phone",
  "category": "relationships", "trigger": "director", "importance": "important", "weight": 7,
  "cooldown": { "maxPerSession": 1 }, "tags": ["secret"],
  "roles": {
    "finder": { "count": 1 },
    "owner": { "count": 1, "conditions": { "relation": { "to": "role:finder", "typeIn": ["partner"] } } }
  },
  "text": {
    "public": "{owner}'s phone lights up on the table while {finder} is sitting next to it.",
    "private": {
      "finder": "From an unknown number: \"Last night was wonderful. Can't wait for Saturday.\"",
      "owner": "The message is from your sister: you are secretly planning a surprise party for {finder} on Saturday."
    }
  },
  "choices": {
    "finder": [
      { "id": "confront", "label": "Ask {owner} who it is from", "tags": ["truth"], "perceived": { "relation": { "owner": -1 } } },
      { "id": "snoop", "label": "Read the rest of the messages when they are not looking", "tags": ["lie", "risk"], "perceived": { "risk": 1, "relation": { "owner": -1 } } },
      { "id": "calm_talk", "label": "Mention it calmly, without accusing", "tags": ["truth", "negotiate"], "careers": ["psychologist"], "perceived": { "relation": { "owner": 1 } } },
      { "id": "swallow", "label": "Say nothing and stew on it", "tags": ["ignore"], "default": true, "perceived": { "mental": -1 } }
    ],
    "owner": [
      { "id": "reveal", "label": "Tell {finder} about the surprise party", "tags": ["truth", "sacrifice"], "perceived": { "relation": { "finder": 1 } } },
      { "id": "deflect", "label": "Say it is \"nothing, just work\"", "tags": ["lie"], "default": true, "perceived": { "risk": 1 } }
    ]
  },
  "outcomes": [
    { "id": "surprise_saved_trust", "when": { "chose": "calm_talk", "role": "finder" }, "revealChoices": true,
      "effects": [{ "type": "relation", "from": "role:finder", "to": "role:owner", "trust": 10, "affinity": 10, "mutual": true }],
      "text": { "finder": "{owner} grins and says \"wait until Saturday\". You decide to trust them.", "owner": "{finder} asks so gently that you just say \"trust me\". They do." } },
    { "id": "party_spoiled", "when": { "chose": "reveal", "role": "owner" }, "revealChoices": true,
      "effects": [{ "type": "relation", "from": "role:finder", "to": "role:owner", "affinity": 15, "trust": 10, "mutual": true }],
      "text": { "finder": "A surprise party — for you. You feel silly, and loved.", "owner": "The surprise is ruined, but {finder} is touched." } },
    { "id": "suspicion", "when": { "any": [ { "chose": "confront", "role": "finder" }, { "chose": "snoop", "role": "finder" } ] }, "important": true,
      "effects": [
        { "type": "fact", "target": "role:finder", "key": "suspects_partner", "about": "role:owner" },
        { "type": "relation", "from": "role:finder", "to": "role:owner", "trust": -25, "affinity": -15 },
        { "type": "relation", "from": "role:owner", "to": "role:finder", "trust": -10 },
        { "type": "attr", "target": "role:finder", "delta": { "mental": -8 } }
      ],
      "followUps": [{ "event": "relationships_crisis_talk", "delaySeconds": [30, 70], "roles": { "a": "role:finder", "b": "role:owner" } }],
      "text": { "finder": "\"Nothing, just work.\" You do not believe a word.", "owner": "{finder} is acting strangely. They must suspect something." } },
    { "id": "stewing", "effects": [
        { "type": "fact", "target": "role:finder", "key": "suspects_partner", "about": "role:owner" },
        { "type": "attr", "target": "role:finder", "delta": { "mental": -6 } }, { "type": "relation", "from": "role:finder", "to": "role:owner", "trust": -10 } ],
      "text": { "finder": "You say nothing. The message plays on a loop in your head.", "owner": "{finder} seems quiet tonight." } }
  ]
}
